				(size 1.27 1.27)
			)
		)
		(uuid "b2a10000-0000-4000-8000-000000000008")
	)
	(text "Rev C: TP4057(~370mA)+D1/Q1 load-share+XC6220(1A)/HT7533 LDOs. ESP32-S3-WROOM-1-N16R8: 16MB flash + 8MB octal PSRAM (IO35-37 in-use). JLCPCB basic parts where possible"
