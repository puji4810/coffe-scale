	(text "U4 ESP32-S3-WROOM-1-N16R8: EN = R5 10k + C14 1u RC; BOOT = IO0 low at reset (TP4 to GND)"
		(exclude_from_sim no)
		(at 223.52 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b2a10000-0000-4000-8000-00000000025f")
	)
	(text "USB = IO19/IO20 native USB-Serial/JTAG via R19/R20 22R. UART0 on TP5/TP6 + J10. INT1 on IO13 p21. INT2 left NC. IO45/46 strapping + IO35-37 octal PSRAM left NC. IO1/14/15/17/38-42/47 -> J10 expansion. BTN_TARE on IO48 (non-strapping). LCD_RST = local RC (R21/C26)."
		(exclude_from_sim no)
		(at 223.52 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b2a10000-0000-4000-8000-000000000260")
	)
