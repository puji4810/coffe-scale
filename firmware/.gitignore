# ESP-IDF build output
/build-esp32s3/
/build/
/managed_components/

# korvo1-remote is a separate IDF project with its own build dir and
# managed_components (registry deps pinned in dependencies.lock)
/korvo1-remote/build-s31/
/korvo1-remote/managed_components/

# xmake host cache
/.xmake/

# web wasm output (regenerate: web/wasm/build.sh) and a site.sh run from
# inside web/
/web/dist/
/web/_site/

# OCR runtime + models (regenerate: web/fetch_ocr.sh) — large binaries
/web/vendor/ort/
/web/vendor/ocr/

# local node deps for the optional OCR e2e test
/web/node_modules
/web/package*.json
